<style>
body,h1,h2,h3,h4,h5,h6 {
    font-family: "Lato", sans-serif
}
.w3-bar,h1,button {
    font-family: "Montserrat", sans-serif
}
.fa-anchor,.fa-coffee,.fa-hourglass,.fa-share,.fa-gavel,.fa-envelope,.fa-phone,.fa-globe,.fa-building,.fa-balance-scale,
.fa-exclamation-triangle,.fa-external-link,.fa-ban,.fa-exchange,.fa-superpowers,.fa-link,.fa-university,.fa-plus,.fa-undo,
.fa-stop,.fa-check,.fa-certificate,.fa-thumb-tack,.fa-th-list,.fa-eject,.fa-life-ring,.fa-clock-o,.fa-money,.fa-star {
