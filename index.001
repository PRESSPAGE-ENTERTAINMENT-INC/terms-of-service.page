}
</style>
<body>

<!-- Navbar -->
<div class="w3-top">
  <div class="w3-bar w3-red w3-card w3-left-align w3-large">
    <a class="w3-bar-item w3-button w3-hide-medium w3-hide-large w3-right w3-padding-large w3-hover-white w3-large w3-red" href="javascript:void(0);" onclick="myFunction()" title="Toggle Navigation Menu"><i class="fa fa-bars"></i></a>
    <select class="w3-input w3-block" onchange="showSpecificTOS(this)">
        <option value="" title="select to choose brand specific terms of service">Select: Terms of Service</option>
        <option value="presspage">PRESSPAGE ENTERTAINMENT INC</option>
        <option value="snacks4u">dba Snacks-4-U</option>
        <option value="hireme">dba Hire Me for Work</option>
        <option value="redeecash">dba REDEECASH</option>
        <option value="fitnessbrands">dba Fitness Brands</option>
        <option value="mykronee">dba My Kronee Cafe</option>
        <option value="pingleware">dba PINGLEWARE</option>
        <option value="travelingblonde">dba Traveing Blonde</option>
        <option value="gatorgrocerygardening">dba Gator Grocery &amp; Gardening</option>
        <option value="verifiedpress">VERIFIEDPRESS.ORG</option>
    </select>
  </div>

  <!-- Navbar on small screens -->
  <div id="navDemo" class="w3-bar-block w3-white w3-hide w3-hide-large w3-hide-medium w3-large">
    <select class="w3-input w3-block" onchange="showSpecificTOS(this)">
        <option value="" title="select to choose brand specific terms of service">Select: Terms of Service</option>
        <option value="presspage">PRESSPAGE ENTERTAINMENT INC</option>
        <option value="snacks4u">dba Snacks-4-U</option>
        <option value="hireme">dba Hire Me for Work</option>
        <option value="redeecash">dba REDEECASH</option>
        <option value="fitnessbrands">dba Fitness Brands</option>
        <option value="mykronee">dba My Kronee Cafe</option>
        <option value="pingleware">dba PINGLEWARE</option>
        <option value="travelingblonde">dba Traveing Blonde</option>
        <option value="gatorgrocerygardening">dba Gator Grocery &amp; Gardening</option>
        <option value="verifiedpress">VERIFIEDPRESS.ORG</option>
    </select>
  </div>
</div>

<!-- Header -->
<header class="w3-container w3-red w3-center" style="padding:128px 16px">
  <h1 class="w3-margin w3-jumbo">Terms of Service (TOS)</h1>
  <p class="w3-xlarge"></p>
  <a href="mailto:presspage.entertainment@gmail?subject=Request%20from%20privacy-policy.page" class="w3-button w3-black w3-padding-large w3-large w3-margin-top">Contact</a>
  <p class="w3-center">Select a section from the menu above for each specific terms of service.</p>
</header>

